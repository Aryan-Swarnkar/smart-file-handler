# =============================================================================
# smart-file-handler — example environment
# Copy to `.env` and adjust. NEVER commit the real .env.
# =============================================================================

# --- Core -------------------------------------------------------------------
# development: relaxed validation, pretty logs allowed | production: strict
ENV=development
LOG_LEVEL=INFO
# json (default) | console (human-readable, dev convenience only)
LOG_FORMAT=json

# --- Secrets (REQUIRED) ------------------------------------------------------
# Must be >= 32 chars and non-placeholder in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-me-with-the-command-above-and-keep-this-long-64-char-min

# --- Database (PostgreSQL 16 + pgvector) --------------------------------------
# Host-side (pytest / IDE). docker-compose overrides hostnames for containers.
# NOTE: host port is 5433 (5432 is occupied by a stale stage-1 container).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/smart_file_handler

# --- Compose-only vars (used by docker-compose.yml, not by the app) ----------
POSTGRES_DB=smart_file_handler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis (cache, rate limiting, ARQ broker) ---------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally; S3/R2 in production) ----------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smart-file-handler
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- Queue / worker (P4) --------------------------------------------------------
# The API enqueues a pipeline job after each completed processable file; the
# worker ALSO sweeps every SWEEP_INTERVAL_SECONDS to claim any row whose
# enqueue was lost (crash between DB commit and Redis enqueue).
SWEEP_INTERVAL_SECONDS=30
# Init rows (bytes never PUT, presigned URL expired) are deleted by the sweep
# after this grace window — they can never complete.
ORPHAN_INIT_MINUTES=60
# Per-job attempts before the row is marked failed (error shown in the UI).
WORKER_MAX_TRIES=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PRESIGNED_URL_EXPIRE_SECONDS=900

# --- Rate limiting (auth endpoints, per client IP, fixed window) ----------------
# Namespace prefixes Redis keys (tests set a unique one per run).
RATELIMIT_NAMESPACE=rl
LOGIN_RATELIMIT_PER_MINUTE=10
REGISTER_RATELIMIT_PER_MINUTE=5

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# --- Observability (optional) --------------------------------------------------
SENTRY_DSN=
