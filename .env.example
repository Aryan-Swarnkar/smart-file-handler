# =============================================================================
# smart-file-handler — example environment
# Copy to `.env` and adjust. NEVER commit the real .env.
# =============================================================================

# --- Core -------------------------------------------------------------------
# development: relaxed validation, pretty logs allowed | production: strict
ENV=development
LOG_LEVEL=INFO
# json (default) | console (human-readable, dev convenience only)
LOG_FORMAT=json

# --- Secrets (REQUIRED) ------------------------------------------------------
# Must be >= 32 chars and non-placeholder in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-me-with-the-command-above-and-keep-this-long-64-char-min

# --- Database (PostgreSQL 16) -------------------------------------------------
# Host-side (pytest / IDE). docker-compose overrides hostnames for containers.
# NOTE: host port is 5433 (5432 is occupied by a stale stage-1 container).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/smart_file_handler

# --- Compose-only vars (used by docker-compose.yml, not by the app) ----------
POSTGRES_DB=smart_file_handler
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis (cache, rate limiting; Celery broker arrives Phase 6) -------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (SeaweedFS dev stand-in; S3/R2 in production) ------------
# MinIO community edition is discontinued (Docker Hub 404 + dl.min.io 410,
# verified 2026-11-14) — SeaweedFS stays until production S3/R2.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smart-file-handler
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- ML pipeline (Phase 7) ----------------------------------------------------
# ML_STUB=1: workers use fixed-delay fakes with deterministic labels (default).
# Real models only on explicit ask; never alongside Ollama + full stack + Locust.
ML_STUB=1

# --- Quotas (Phase 2/3) -------------------------------------------------------
# Per-user storage quota applied at registration.
DEFAULT_STORAGE_QUOTA_GB=5

# --- ClamAV (Phase 7) -----------------------------------------------------------
# clamd daemon for the scan pipeline (compose service `clamav`).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PRESIGNED_URL_EXPIRE_SECONDS=900

# --- Rate limiting (auth endpoints, per client IP; token bucket lands Phase 3) --
# Namespace prefixes Redis keys (tests set a unique one per run).
RATELIMIT_NAMESPACE=rl
LOGIN_RATELIMIT_PER_MINUTE=10
REGISTER_RATELIMIT_PER_MINUTE=5

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173
